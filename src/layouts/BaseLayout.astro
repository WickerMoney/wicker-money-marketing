---
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const nav = [
  { href: '/self-hosting', label: 'Self-hosting' },
  { href: '/migrate-from-mint', label: 'Migrate from Mint' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/changelog', label: 'Changelog' },
]

// Off-site links: rendered smaller, open in a new tab, and marked with an
// external-link glyph plus screen-reader text so the new-tab behavior isn't a surprise.
const external = [
  { href: 'https://wickermoney.dev', label: 'Docs', icon: null },
  { href: 'https://github.com/wickermoney/wicker-money', label: 'GitHub', icon: 'github' },
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} · Wicker Money</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Wicker Money`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/img/wickermoney-logo-primary.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32.png" />
    <link rel="apple-touch-icon" href="/img/favicon/apple-touch-icon.png" />
  </head>
  <body>
    <header class="wmm-header">
      <div class="wmm-container wmm-header__inner">
        <a href="/" class="wmm-brand" aria-label="Wicker Money home">
          <img class="light-logo" src="/img/wickermoney-logo-horizontal-small.png" alt="Wicker Money" height="44" />
          <img class="dark-logo" src="/img/dark-mode/wickermoney-logo-horizontal-small.png" alt="Wicker Money" height="44" />
        </a>
        <nav class="wmm-nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <span class="wmm-nav__external">
            {external.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.icon === 'github' && (
                  <svg class="wmm-nav__icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                  </svg>
                )}
                {item.label}
                <svg class="wmm-nav__ext" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 2.5h-2v7h7v-2M7 2.5h2.5V5M9.5 2.5 5.5 6.5" />
                </svg>
                <span class="wmm-sr-only">(opens in a new tab)</span>
              </a>
            ))}
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wmm-footer">
      <div class="wmm-container wmm-footer__inner">
        <div class="wmm-footer__brand">
          <img src="/img/icons/wickermoney-icon-cream.png" alt="" width="40" height="40" />
          <p>Wicker Money is self-hosted personal finance software, built by Jeremy Reed. Not backed by anyone.</p>
        </div>
        <div class="wmm-footer__cols">
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href="https://github.com/wickermoney/wicker-money">Source on GitHub</a></li>
              <li><a href="https://wickermoney.dev">Documentation</a></li>
              <li><a href="https://github.com/wickermoney/wicker-money/blob/main/LICENSE">License (AGPL-3.0)</a></li>
            </ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul>
              {nav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li><a href="mailto:support@wicker.money">support@wicker.money</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <style>
      /* Woven stripe across the top of every page: leaf, honey, forest. */
      .wmm-header {
        border-bottom: 1px solid var(--wm-border);
        background: var(--wm-surface);
        border-top: 4px solid transparent;
        border-image: repeating-linear-gradient(90deg, var(--wmm-leaf) 0 48px, var(--wmm-honey) 48px 96px, var(--wmm-forest) 96px 120px) 1;
        border-image-width: 4px 0 0 0;
      }
      .wmm-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--wm-gap);
        padding: 16px 24px;
        flex-wrap: wrap;
      }
      /* Height/width only — never `display` here. `.wmm-brand img` outranks the
         bare .light-logo/.dark-logo classes in global.css, so setting display on
         it would show both theme logos at once. */
      .wmm-brand img {
        height: 44px;
        width: auto;
      }
      @media (max-width: 640px) {
        .wmm-brand img {
          height: 36px;
        }
      }
      .wmm-nav {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 0.9375rem;
      }
      .wmm-nav a {
        color: var(--wm-text);
        text-decoration: none;
      }
      .wmm-nav a:hover {
        color: var(--wm-accent);
      }
      .wmm-nav__external {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-left: 20px;
        border-left: 1px solid var(--wm-border);
        font-size: 0.8125rem;
      }
      .wmm-nav__external a {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--wm-text-muted);
      }
      .wmm-nav__ext {
        opacity: 0.7;
      }
      .wmm-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .wmm-footer {
        --wm-text: var(--wmm-cream);
        --wm-text-muted: var(--wmm-cream-muted);
        --wm-accent: var(--wmm-leaf-light);

        background: var(--wmm-forest);
        color: var(--wm-text);
        margin-top: 64px;
      }
      .wmm-footer__brand img {
        border-radius: 10px;
      }
      .wmm-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 48px;
        justify-content: space-between;
        padding: 48px 24px;
      }
      .wmm-footer__brand {
        max-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .wmm-footer__brand p {
        color: var(--wm-text-muted);
        font-size: 0.875rem;
        margin: 0;
      }
      .wmm-footer__cols {
        display: flex;
        gap: 48px;
        flex-wrap: wrap;
      }
      .wmm-footer h4 {
        margin: 0 0 12px;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--wmm-honey-light);
      }
      .wmm-footer ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .wmm-footer a {
        color: var(--wm-text);
        text-decoration: none;
        font-size: 0.9375rem;
      }
      .wmm-footer a:hover {
        color: var(--wm-accent);
      }
    </style>
  </body>
</html>
