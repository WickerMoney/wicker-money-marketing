---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist on the Wicker Money site."
  noindex
>
  <section class="wmm-section wmm-page-hero">
    <div class="wmm-container">
      <p class="wmm-eyebrow">404</p>
      <h1>That page isn't here</h1>
      <p class="wmm-lede">
        It may have moved, or the link may be mistyped. Try the
        <a href="/self-hosting">self-hosting guide</a>, see
        <a href="/features">what's shipped</a>, or head back to the
        <a href="/">home page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
